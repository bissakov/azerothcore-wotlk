[Unit]
Description=AzerothCore server-life telemetry observer
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Work/Misc/azerothcore-wotlk
ExecStart=/usr/bin/python3 %h/Work/Misc/azerothcore-wotlk/apps/server-life-observer.py watch --interval 900 --stall-hours 6
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
