# Template for .env, which git ignores (/.env* in .gitignore). Copy this to
# .env and fill in the values - never move real secrets into a tracked file.
#
# Any AzerothCore config option can be overridden from the environment: prefix
# AC_, turn dots into underscores, and split camelCase humps. So
# LLMChat.ApiKey becomes AC_LLMCHAT_API_KEY. The override applies on
# `.llm reload` too, since that re-runs the config manager.
#
# Model selection deliberately lives in the conf file rather than here:
# LLMChat.Model / .Model.Chatter / .Model.Sentiment in
# env/dist/etc/modules/mod_llm_chat.conf are reloadable in-game with
# `.llm reload`, while changing anything here needs a container recreate.
AC_LLMCHAT_API_KEY=

# Playerbot scale, consumed by docker-compose.override.yml. The values shown
# are the defaults applied when these stay unset.
#BOT_MIN_COUNT=600
#BOT_MAX_COUNT=1000
#BOT_LOGIN_BATCH=30
